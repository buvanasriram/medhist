
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "rootDir": "."
  },
  "include": [
    "index.tsx",
    "App.tsx",
    "types.ts",
    "credentials.ts",
    "vite-env.d.ts",
    "setupTests.ts",
    "components/**/*",
    "services/**/*",
    "utils/**/*"
  ],
  "exclude": [
    "src",
    "**/src/*",
    "node_modules",
    "dist",
    "e2e", 
    "scripts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
